---
import type { TODO } from '#utils/types.js'
import Blank from './Blank.astro'
import BlogPosts from './BlogPosts.astro'

export type Props = {
  page: TODO
  /** Route the detail pages live under: `posts` (the default) or `content`. */
  to?: string
}

const { page, to } = Astro.props as Props
---

{
  page?.data.length ? (
    page?.data.map((post: TODO) => (
      <article>
        <BlogPosts
          url={`/${to || 'posts'}/${post.id}`}
          title={post.data.title}
          description={post.data.description}
        />
      </article>
    ))
  ) : (
    <>
      <h3>Sorry no content found...</h3>
      <Blank />
    </>
  )
}

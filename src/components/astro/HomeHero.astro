---
/**
 * Homepage hero.
 *
 * Replaces the shared `Header` on `/` only, by way of the `header` slot that
 * `src/layouts/Layout.astro` forwards through to `Base.astro`. Every other
 * route falls back to that forwarded slot's default content, which is the
 * shared `Header` itself.
 *
 * The direction is "colour marks hydration": static content is ink on paper,
 * and the accent (`--island`) appears only on things a visitor can operate --
 * the two calls to action, the specimen's own link and the focus rings.
 * Nothing decorative carries it, which keeps the rule machine-checkable.
 *
 * The signature element is the specimen: a `Card` standing in for the dialog the
 * plugin shows on a complex first prompt, above the one command that installs
 * it. The install command comes from `PLUGIN_INSTALL_COMMAND`, so the hero and
 * the README cannot print different commands.
 *
 * @component HomeHero
 * @example
 * ```astro
 * <!-- The slot name is required: without it the hero renders into the page
 *      body and the shared Header stays at the top of the document. -->
 * <Layout pageTitle={SITE_TITLE}>
 *   <HomeHero slot="header" />
 * </Layout>
 *
 * <!-- All three strings are overridable; every one has a default. -->
 * <HomeHero
 *   slot="header"
 *   eyebrow="Claude Code plugin / MIT licensed"
 *   headline="Pick the right model before the first prompt runs."
 *   deck="Rates your first prompt and suggests haiku, sonnet, opus or fable."
 * />
 * ```
 */
import Card from '#components/astro/Card.astro'
import { PLUGIN_INSTALL_COMMAND, PLUGIN_REPO_URL } from '#utils/site-config'

export type Props = {
  /** Mono eyebrow set above the headline. */
  eyebrow?: string
  /** Display headline. Rendered as the page's single `h1`. */
  headline?: string
  /** Deck paragraph, sized at a third of the headline. */
  deck?: string
}

const {
  eyebrow = 'Claude Code plugin / MIT licensed',
  headline = 'Pick the right model before the first prompt runs.',
  deck = 'A Claude Code plugin that rates your first prompt, suggests haiku, sonnet, opus or fable to match, and raises effort when it is set too low.',
} = Astro.props as Props

// An illustration of the dialog described in the README, not a screenshot: a
// complex prompt on sonnet, where opus is suggested. The dialog opens with the
// one-line restatement the rating call returns. It does not mention the effort
// floor (the README: no model's default effort is below it).
const specimenTitle = 'Rated complex'
const specimenBody =
  'Read as: add a retry limit to the upload client. You are on sonnet. Switch to opus, keep sonnet, or refine the prompt first.'

// The overview article, and the destination for both the secondary CTA and the
// specimen card. Not `/docs`: that route calls `getEntry('docs', '0-welcome')`
// for an entry the collection does not contain and passes the `undefined`
// straight into `render()`, so it answers 500.
const howItWorksLink = '/content'

// The README's Install section holds the terminal, shell and desktop-app steps,
// so the primary CTA sends visitors there instead of repeating all three.
const installLink = `${PLUGIN_REPO_URL}#install`
---

<header class="home-hero" data-home-hero>
  <div class="home-hero__lede">
    <p class="home-hero__eyebrow" data-ui="eyebrow">{eyebrow}</p>
    <h1 class="home-hero__display" data-ui="display">{headline}</h1>
    <p class="home-hero__deck" data-home-hero-deck>{deck}</p>

    <div class="home-hero__cta">
      <a class="home-hero__button" href={installLink}>Install the plugin</a>
      <a class="home-hero__button home-hero__button--ghost" href={howItWorksLink}>
        See how it works
      </a>
    </div>

    <p class="home-hero__legend">
      <b>One haiku call per session,</b> plus one when you refine a prompt (two if you answer its questions),
      and a second rating if you refine from the first-prompt dialog. Prompts are never stored, and the
      plugin makes no network requests of its own.
    </p>
  </div>

  <figure class="home-hero__specimen">
    <figcaption class="home-hero__specimen-label">Example dialog</figcaption>
    <div class="home-hero__specimen-body">
      <Card cardTitle={specimenTitle} cardLink={howItWorksLink}>
        <p>{specimenBody}</p>
      </Card>
    </div>
    <div class="home-hero__install">
      <pre class="home-hero__code"><code data-install-command>{PLUGIN_INSTALL_COMMAND}</code></pre>
      <!-- Hidden until the script below runs: without JS the button could not copy. -->
      <button class="home-hero__copy" type="button" data-copy-install hidden>Copy</button>
      <span class="home-hero__copy-status" role="status" data-copy-status></span>
    </div>
  </figure>
</header>

<script>
  const button = document.querySelector<HTMLButtonElement>('[data-copy-install]')
  const command = document.querySelector('[data-install-command]')
  const status = document.querySelector('[data-copy-status]')
  let resetTimer: number | undefined

  if (button && command && status && navigator.clipboard) {
    button.hidden = false
    button.addEventListener('click', async () => {
      // Cleared first so a repeat click inside the reset window still changes
      // the live region and is announced again.
      status.textContent = ''
      try {
        await navigator.clipboard.writeText(command.textContent ?? '')
        button.textContent = 'Copied'
        status.textContent = 'Install command copied'
      } catch {
        button.textContent = 'Failed'
        status.textContent = 'Could not copy the install command'
      }
      window.clearTimeout(resetTimer)
      resetTimer = window.setTimeout(() => {
        button.textContent = 'Copy'
        status.textContent = ''
      }, 2000)
    })
  }
</script>

<style>
  .home-hero {
    /*
     * One knob drives both type sizes, so the display-to-deck ratio is pinned
     * at 3.2 at every viewport width rather than only at the desktop clamp.
     * The review measured 1.63; the gate is 3.0.
     */
    --hero-display-size: clamp(3rem, 6.6vw, 4.5rem);
    --hero-deck-size: calc(var(--hero-display-size) / 3.2);

    /*
     * Direction tokens with literal fallbacks. The fallbacks keep the hero
     * legible if it is rendered before the token layer loads; once
     * `_design-tokens.scss` defines them, the tokens win and dark mode flips
     * every surface here with the rest of the page.
     */
    --hero-ink: var(--ink, #101418);
    --hero-ink-soft: var(--ink-soft, #5a6472);
    --hero-paper: var(--paper, #fcfcfd);
    --hero-paper-sunk: var(--paper-sunk, #f1f3f5);
    --hero-island: var(--island, #0b6070);
    --hero-island-bg: var(--island-bg, #e6f2f6);
    --hero-rule: var(--rule, #dde1e6);

    /*
     * Hover and pressed fills, mixed toward ink. `--ink` is near-black in light
     * and near-white in dark, so one pair of declarations darkens the accent on
     * paper and lightens it on the dark surface -- no second theme block, and
     * the label's contrast rises rather than falls in both directions. Mixed in
     * oklch so the darkened accent keeps its chroma; the same mix in sRGB
     * muddies a saturated violet.
     */
    --hero-island-hover: color-mix(in oklch, var(--hero-island) 88%, var(--hero-ink));
    --hero-island-active: color-mix(in oklch, var(--hero-island) 78%, var(--hero-ink));

    align-items: start;
    box-sizing: border-box;
    color: var(--hero-ink);
    display: grid;
    gap: 3.5rem;
    grid-template-columns: minmax(0, 1fr) minmax(0, 420px);

    /*
     * Undoes the vendor overlay grid: `grid-template-areas: "overlay"` plus the
     * `minmax(300px, auto)` row floor `_base.scss` puts on every header. The
     * `fit-content` min-height also beats acss's `min-height: 40vh`, which
     * would otherwise leave a tall empty band under the content.
     */
    grid-template-areas: none;
    grid-template-rows: auto;
    min-height: fit-content;

    /* The same vendor sheet floors every header at `min-width: 20rem`. With a
       classic scrollbar a 320px viewport leaves 305px of layout, so the band
       overflowed by 15px and the page scrolled sideways (SC 1.4.10 Reflow,
       which is tested at 400% zoom on desktop browsers that have one). */
    min-width: 0;
    padding-block: 4.5rem 4rem;

    /*
     * Full-bleed band. The background is painted by this element, so
     * constraining the element itself to `--max-content-width` stopped the
     * surface short of the viewport edge while the shared `Header` on every
     * other route ran edge to edge. Spanning the full width and pushing the
     * content in with padding keeps the grid on the same 80rem measure without
     * a wrapper element. Below 80rem the subtraction goes negative and `max()`
     * falls back to the 1.25rem gutter, so 320px reflow is unchanged.
     */
    padding-inline: max(1.25rem, calc((100% - var(--max-content-width, 80rem)) / 2));
    width: 100%;
  }

  /*
   * @fpkit/acss ships an "overlay" pattern keyed on the `header` element: it
   * forces every direct child into `grid-area: overlay` and centres
   * `header > div` inside a capped, padded column. Left unreset that collapses
   * this two-column layout into a single stacked area, so the pattern is
   * undone here rather than giving up the banner landmark.
   */
  .home-hero > * {
    grid-area: auto;
  }

  .home-hero > .home-hero__lede {
    gap: 0;
    margin-inline: 0;
    max-width: none;
    padding-inline: 0;
    text-align: left;
  }

  .home-hero .home-hero__lede,
  .home-hero .home-hero__specimen {
    /* Grid items default to `min-width: auto`, which lets a long word or the
       code sample push the page wider than the viewport at 320px. */
    min-width: 0;
  }

  .home-hero .home-hero__eyebrow {
    color: var(--hero-ink-soft);
    font-family: var(--font-family-mono, ui-monospace, monospace);
    font-size: 0.75rem;
    letter-spacing: 0.14em;
    margin: 0 0 1.25rem;
    max-width: none;
    text-transform: uppercase;
  }

  .home-hero .home-hero__display {
    color: var(--hero-ink);
    font-family: var(--font-family-display, inherit);
    font-size: var(--hero-display-size);
    font-weight: 600;
    letter-spacing: -0.035em;
    line-height: 1.02;
    margin: 0 0 1.25rem;

    /* Left, not centred. A long compound word must break rather than widen
       the document at 320px. Hyphenation stays manual above 21rem: with
       `auto` everywhere the browser split "compo-nents" at 390px even though
       the word (286px at the 3rem floor) fits the column on a line of its own.
       Below 21rem it no longer fits, and a hyphen beats a bare mid-word break. */
    hyphens: manual;
    overflow-wrap: break-word;
    text-align: left;

    /* Evens the lines so a short headline never strands its last word alone
       ("agent." sat on its own line at 1440px). */
    text-wrap: balance;
    text-transform: none;
  }

  .home-hero .home-hero__deck {
    color: var(--hero-ink-soft);
    font-size: var(--hero-deck-size);
    line-height: 1.5;
    margin: 0;
    max-width: 46ch;
  }

  .home-hero .home-hero__cta {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
    margin-block-start: 2rem;
  }

  /* Interactive, so it may carry the accent. */
  .home-hero .home-hero__button {
    background: var(--hero-island);
    border: 1px solid var(--hero-island);
    border-radius: var(--radius, 0.5rem);

    /*
     * Paper, not a literal white. The accent lightens in dark mode, so white
     * label text would drop to about 2.5:1 there; inverting to the paper token
     * measures 7.01:1 in light and 8.54:1 in dark.
     */
    color: var(--hero-paper);
    display: inline-block;
    font-size: 0.9375rem;
    font-weight: 600;
    padding: 0.6875rem 1.25rem;
    text-decoration: none;

    /* Colour only. Nothing here moves, so there is no motion to suppress
       under `prefers-reduced-motion`. */
    transition:
      background-color var(--transition-duration-150, 150ms) ease-out,
      border-color var(--transition-duration-150, 150ms) ease-out;
  }

  /*
   * The secondary carries the accent on its label alone; its border drops to
   * the neutral rule. Both buttons previously painted the border in full-chroma
   * `--island`, which measured the same 7.01:1 in light as the primary's fill
   * (8.54:1 in dark) and left the pair reading as two equal calls to action. The accent still marks the
   * control -- the direction only forbids accenting things a visitor cannot
   * operate -- so the e2e assertion is unaffected.
   */
  .home-hero .home-hero__button--ghost {
    background: transparent;
    border-color: var(--hero-rule);
    color: var(--hero-island);
  }

  .home-hero .home-hero__button:hover {
    background: var(--hero-island-hover);
    border-color: var(--hero-island-hover);

    /* Non-colour hover cue, so the state does not rely on hue alone. */
    text-decoration: underline;
    text-underline-offset: 3px;
  }

  .home-hero .home-hero__button:active {
    background: var(--hero-island-active);
    border-color: var(--hero-island-active);
  }

  /* Hover is where the secondary earns its border: the tint arrives and the
     rule gives way to the accent, which is the affordance the resting state
     trades away for hierarchy. */
  .home-hero .home-hero__button--ghost:hover {
    background: var(--hero-island-bg);
    border-color: var(--hero-island);
  }

  .home-hero .home-hero__button--ghost:active {
    background: color-mix(in oklch, var(--hero-island) 18%, transparent);
    border-color: var(--hero-island);
  }

  .home-hero .home-hero__button:focus-visible {
    outline: 2px solid var(--hero-island);
    outline-offset: 3px;
  }

  /*
   * Deliberately not accented. The legend is static text, and the accent is
   * reserved for things a visitor can operate, so it stays in ink.
   */
  .home-hero .home-hero__legend {
    border-top: 1px solid var(--hero-rule);
    color: var(--hero-ink-soft);
    font-family: var(--font-family-mono, ui-monospace, monospace);
    font-size: 0.71875rem;
    line-height: 1.6;
    margin-block-start: 2.25rem;
    max-width: 52ch;
    padding-block-start: 1rem;
  }

  .home-hero .home-hero__legend b {
    color: var(--hero-ink);
    font-weight: 650;
  }

  .home-hero .home-hero__specimen {
    background: var(--hero-paper);
    border: 1px solid var(--hero-rule);
    border-radius: var(--radius, 0.5rem);
    margin: 0;
    max-width: 100%;
    overflow: hidden;
  }

  .home-hero .home-hero__specimen-label {
    background: var(--hero-paper-sunk);
    border-bottom: 1px solid var(--hero-rule);
    color: var(--hero-ink-soft);
    font-family: var(--font-family-mono, ui-monospace, monospace);
    font-size: 0.65625rem;
    letter-spacing: 0.12em;
    padding: 0.625rem 1rem;
    text-transform: uppercase;
  }

  .home-hero .home-hero__specimen-body {
    padding: 1.5rem 1.25rem;
  }

  .home-hero .home-hero__install {
    align-items: flex-start;
    background: var(--hero-paper-sunk);
    border-block-start: 1px solid var(--hero-rule);
    display: flex;

    /* Wraps so that when text is enlarged (200% at 320px) the button drops
       below the command instead of squeezing it to one character per line. */
    flex-wrap: wrap;
    gap: 0.75rem;
    padding: 0.75rem 0.75rem 0.75rem 1.25rem;
  }

  .home-hero .home-hero__code {
    background: transparent;
    border: 0;
    border-radius: 0;
    color: var(--hero-ink-soft);
    flex: 1 1 14ch;
    font-family: var(--font-family-mono, ui-monospace, monospace);
    font-size: 0.78125rem;
    line-height: 1.7;
    margin: 0;

    /* The install command is longer than a 320px viewport. It wraps inside
       this box, breaking mid-token only when a token alone is too wide, so
       there is no scroll region and no scrollbar. */
    min-width: 0;
    overflow: hidden;
    overflow-wrap: anywhere;
    padding: 0.25rem 0;
    white-space: pre-wrap;
  }

  .home-hero .home-hero__code code {
    color: inherit;
    font-family: inherit;
    font-size: inherit;
  }

  /* Interactive, so it may carry the accent. Styled as the ghost button. */
  .home-hero .home-hero__copy {
    background: transparent;
    border: 1px solid var(--hero-rule);
    border-radius: var(--radius, 0.5rem);
    color: var(--hero-island);
    cursor: pointer;
    flex-shrink: 0;
    font-size: 0.75rem;
    font-weight: 600;

    /* Wide enough for the longest label ("Copied"), so swapping labels never
       resizes the button and reflows the wrapped command beside it. */
    min-inline-size: 5.75em;
    padding: 0.375rem 0.75rem;
    transition:
      background-color var(--transition-duration-150, 150ms) ease-out,
      border-color var(--transition-duration-150, 150ms) ease-out;
  }

  .home-hero .home-hero__copy[hidden] {
    display: none;
  }

  .home-hero .home-hero__copy:hover {
    background: var(--hero-island-bg);
    border-color: var(--hero-island);
  }

  .home-hero .home-hero__copy:focus-visible {
    outline: 2px solid var(--hero-island);
    outline-offset: 2px;
  }

  .home-hero .home-hero__copy-status {
    clip-path: inset(50%);
    height: 1px;
    overflow: hidden;
    position: absolute;
    white-space: nowrap;
    width: 1px;
  }

  @media (max-width: 60rem) {
    .home-hero {
      gap: 2.25rem;
      grid-template-columns: minmax(0, 1fr);
      padding-block: 3rem 2.5rem;
    }
  }

  @media (max-width: 21rem) {
    .home-hero .home-hero__display {
      hyphens: auto;
    }
  }
</style>

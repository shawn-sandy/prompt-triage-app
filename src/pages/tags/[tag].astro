---
import { getCollection } from 'astro:content'
import Layout from '../../layouts/Layout.astro'
import BlogPost from '../../components/astro/BlogPosts.astro'

// The site runs in server mode, where Astro ignores `getStaticPaths` props for a page that is not
// prerendered. Without this the page received no posts and rendered an empty body.
export const prerender = true

export async function getStaticPaths() {
  const allPosts = await getCollection('posts')

  // `tags` is optional; a tagless post must not become an `undefined` route parameter.
  const uniqueTags = [...new Set(allPosts.flatMap(post => post.data.tags ?? []))]

  return uniqueTags.map(tag => {
    const filteredPosts = allPosts.filter(post => {
      if (post.data.tags) {
        return post.data.tags.includes(String(tag))
      }
    })
    return {
      params: { tag },
      props: { posts: filteredPosts },
    }
  })
}

const { tag } = Astro.params
const { posts } = Astro.props
---

<Layout pageTitle={`Tag: ${tag}`} pageDescription={`prompt-triage posts tagged ${tag}.`}>
  <ul data-list="unstyled">
    {
      posts?.map(post => (
        <li>
          <BlogPost
            url={`/posts/${post.id}`}
            title={post.data.title}
            description={post.data.description}
          />
        </li>
      ))
    }
  </ul>
</Layout>

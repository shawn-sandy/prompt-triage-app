---
import Layout from '#layouts/Layout.astro'
import ContactForm from '#components/react/ContactForm'
import { PLUGIN_REPO_URL } from '#utils/site-config'
---

<Layout
  pageTitle="Contact Us"
  pageDescription="Report a bug, request a feature or ask a question about the prompt-triage plugin."
>
  <h3>Questions, bug reports and ideas</h3>
  <hr />
  <section>
    <p>
      Bug reports and feature requests are easiest to track as an issue on the
      <a href={`${PLUGIN_REPO_URL}/issues`}>prompt-triage GitHub repository</a>, where the answer
      stays findable for the next person. For anything else, use the form below.
    </p>
    <hr />

    <!-- 
    <h3>Stay Connected</h3>
    <p>
      Follow us on social media [insert social media links] to stay updated on
      our latest projects and events.
    </p>
    -->
  </section>

  <ContactForm client:load csrfToken={Astro.locals.csrfToken} />
</Layout>
